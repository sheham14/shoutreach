{
  "device": "desktop", "user": "sheham", "prefix": "e",
  "steps": [
    {"name": "contacts-panel", "do": [["js", "showSection('contacts')"], ["wait", 600], ["click", "#section-contacts tbody tr:nth-child(1) .biz-name"]]},
    {"name": "contacts-unassigned", "do": [["js", "setTab('contacts','unassigned')"]]},
    {"name": "contacts-deleted", "do": [["js", "setTab('contacts','deleted')"]]},
    {"name": "contacts-selected", "do": [["js", "setTab('contacts','all')"], ["wait", 600], ["click", "#section-contacts tbody tr:nth-child(1) input[type=checkbox]"], ["click", "#section-contacts tbody tr:nth-child(2) input[type=checkbox]"]]},
    {"name": "wa-leads-panel", "do": [["js", "showSection('whatsapp'); setTab('whatsapp','leads')"], ["wait", 700], ["select", "#wl-stage", "messaged"], ["wait", 600], ["click", "#wl-body tbody tr:nth-child(2) .biz-name"]]},
    {"name": "wa-stage-dialog", "do": [["click", "#wl-panel a:has-text('Set a stage')"]]},
    {"name": "wa-stage-dialog-booked", "do": [["js", "const r=[...document.querySelectorAll('#modal-choose input[type=radio]')].find(x=>x.value==='booked'); if(r){r.click();}"], ["wait", 500]], "full": false},
    {"name": "wa-stage-dialog-eval", "noshot": true, "do": [["eval", "() => ({h: document.querySelector('#modal-choose .modal').scrollHeight, vh: innerHeight, inputs: document.querySelectorAll('#modal-choose input, #modal-choose select, #modal-choose textarea').length})"]]},
    {"name": "wa-booked-panel", "do": [["js", "chooseCancel(); setTab('whatsapp','booked')"], ["wait", 600], ["click", "#wa-booked-body tbody tr:nth-child(1) .biz-name >> nth=1"]]},
    {"name": "wa-todo-1280", "do": [["size", 1280, 720], ["js", "setTab('whatsapp','todo')"], ["wait", 700]]},
    {"name": "wa-leads-1280", "do": [["js", "setTab('whatsapp','leads')"], ["wait", 700]]},
    {"name": "calling-1280", "do": [["js", "showSection('calling'); setTab('calling','todo')"], ["wait", 700]]},
    {"name": "wa-todo-1024", "do": [["size", 1024, 768], ["js", "showSection('whatsapp'); setTab('whatsapp','todo')"], ["wait", 700]]},
    {"name": "email-campaign-detail", "do": [["size", 1440, 900], ["js", "showSection('email'); setTab('email','campaigns'); await openCampaign(1)"], ["wait", 700]]},
    {"name": "email-campaign-detail-full", "do": [], "full": true},
    {"name": "email-step-editor", "do": [["js", "await editStep(1)"], ["wait", 500]]},
    {"name": "calling-leads", "do": [["js", "document.querySelectorAll('.modal-overlay.open').forEach(m=>m.classList.remove('open')); showSection('calling'); setTab('calling','leads')"]]},
    {"name": "calling-script", "do": [["js", "setTab('calling','script')"]], "full": true},
    {"name": "calling-todo-full", "do": [["js", "setTab('calling','todo')"], ["wait", 600]], "full": true},
    {"name": "getleads-import", "do": [["js", "showSection('scraper'); setTab('scraper','import')"]], "full": true},
    {"name": "getleads-history", "do": [["js", "setTab('scraper','history')"]]},
    {"name": "settings-team", "do": [["js", "showSection('settings'); setTab('settings','team')"]], "full": true},
    {"name": "settings-mine-full", "do": [["js", "setTab('settings','mine')"]], "full": true},
    {"name": "logs", "do": [["js", "showSection('logs')"]]},
    {"name": "database", "do": [["js", "showSection('database')"]]},
    {"name": "help", "do": [["js", "showSection('help')"]]},
    {"name": "wa-addleads-modal", "do": [["js", "showSection('whatsapp'); setTab('whatsapp','todo'); openWaImportModal()"], ["wait", 600]]},
    {"name": "new-email-campaign", "do": [["js", "document.querySelectorAll('.modal-overlay.open').forEach(m=>m.classList.remove('open')); showSection('email'); openNewCampaignModal()"]]},
    {"name": "focus-ring", "do": [["js", "document.querySelectorAll('.modal-overlay.open').forEach(m=>m.classList.remove('open')); showSection('whatsapp'); setTab('whatsapp','todo')"], ["wait", 500], ["js", "document.querySelector('.tabs .tab').focus()"], ["eval", "() => { const out=[]; for (const sel of ['.tab','.btn-primary','.btn-ghost','.chip','.filter-select','.search-input','nav a','.soft-input','.row-menu > .btn']) { const el=document.querySelector(sel); if(!el){out.push([sel,'missing']);continue;} el.focus(); const cs=getComputedStyle(el); out.push([sel, cs.outlineStyle, cs.outlineWidth, cs.boxShadow.slice(0,30)]); } return out; }"]], "noshot": true}
  ]
}
