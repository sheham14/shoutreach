{
  "device": "phone", "user": "sheham", "prefix": "p", "login_shot": true,
  "steps": [
    {"name": "dashboard", "do": [["js", "showSection('dashboard')"]]},
    {"name": "dashboard-full", "do": [], "full": true},
    {"name": "sidebar-open", "do": [["tap", ".sidebar-toggle"]]},
    {"name": "wa-todo", "do": [["js", "window.openWhatsAppChat = () => {}; try{localStorage.removeItem('tab:whatsapp')}catch(e){}; showSection('whatsapp'); setTab('whatsapp','todo')"]]},
    {"name": "wa-todo-lead", "do": [["tap", "#wa-queue tr:nth-child(3) td.m-card"]]},
    {"name": "wa-todo-lead-full", "do": [], "full": true},
    {"name": "wa-todo-opened", "do": [["tap", "#wa-actions .btn-primary"]]},
    {"name": "wa-todo-sent-next", "do": [["tap", ".confirm-send .btn-primary"]]},
    {"name": "wa-todo-menu", "do": [["tap", "#wa-panel .row-menu > .btn"]]},
    {"name": "wa-todo-due", "do": [["js", "closeAllSheets(); document.querySelectorAll('.row-menu.open').forEach(m=>m.classList.remove('open')); setWaBucket('due')"]]},
    {"name": "wa-todo-due-lead", "do": [["tap", "#wa-queue tr:nth-child(1) td.m-card"]]},
    {"name": "wa-leads", "do": [["js", "closeAllSheets(); setTab('whatsapp','leads')"]]},
    {"name": "wa-leads-full", "do": [], "full": true, "noshot": true},
    {"name": "wa-leads-panel", "do": [["tap", "#wl-body tbody tr:nth-child(2) td.m-card"]]},
    {"name": "wa-leads-panel-full", "do": [], "full": true},
    {"name": "meetings", "do": [["js", "closeAllSheets(); showSection('meetings')"], ["wait", 600]]},
    {"name": "meetings-panel", "do": [["tap", "#mt-body tr.clickable td.m-card >> nth=0"]]},
    {"name": "meetings-panel-full", "do": [], "full": true},
    {"name": "wa-campaigns-back", "noshot": true, "do": [["js", "closeAllSheets(); showSection('whatsapp')"]]},
    {"name": "wa-campaigns", "do": [["js", "closeAllSheets(); setTab('whatsapp','campaigns')"]]},
    {"name": "wa-messages", "do": [["js", "setTab('whatsapp','templates')"]]},
    {"name": "wa-messages-full", "do": [], "full": true},
    {"name": "wa-addleads", "do": [["js", "setTab('whatsapp','todo'); openWaImportModal()"]]},
    {"name": "calling-todo", "do": [["js", "document.querySelectorAll('.modal-overlay.open').forEach(m=>m.classList.remove('open')); showSection('calling'); setTab('calling','todo')"]]},
    {"name": "calling-lead", "do": [["tap", "#cq-table tr:nth-child(1) td.m-card"]]},
    {"name": "calling-lead-full", "do": [], "full": true},
    {"name": "contacts", "do": [["js", "closeAllSheets(); showSection('contacts')"]]},
    {"name": "contacts-panel", "do": [["tap", "#section-contacts tbody tr:nth-child(1) td.m-card"]]},
    {"name": "email-todo", "do": [["js", "closeAllSheets(); showSection('email'); setTab('email','todo')"]]},
    {"name": "email-campaigns", "do": [["js", "setTab('email','campaigns')"]]},
    {"name": "getleads-import", "do": [["js", "showSection('scraper'); setTab('getleads','import')"]]},
    {"name": "getleads-import-full", "do": [], "full": true},
    {"name": "settings", "do": [["js", "showSection('settings')"]]}
  ]
}
